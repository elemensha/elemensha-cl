# elemensha — 자동 HTTPS 리버스 프록시
#
# @DOMAIN@ 자리는 배포 스크립트가 채운다. 직접 고칠 때는:
#   sudo sed -i 's/@DOMAIN@/내도메인.duckdns.org/' /etc/caddy/elemensha-claude-bot.caddy
#   sudo systemctl reload caddy
#
# 도메인이 없다면 DuckDNS 가 무료다:
#   1) https://www.duckdns.org 에서 깃허브/구글 로그인
#   2) 서브도메인 생성 (예: elemensha-claude)
#   3) VM 공인 IP 입력 -> update ip
#
# 앱은 반드시 https:// 로 접속한다. API 키가 오가는 경로이므로 평문 http 는 쓰지 않는다.
# Caddy 가 Let's Encrypt 인증서를 자동 발급·갱신하고, http 요청은 308 로 https 에 넘긴다.
#
# 로그는 파일이 아니라 journald 로 남긴다:
#   sudo journalctl -u caddy -f
# (파일 로깅을 쓰면 caddy 서비스의 systemd 하드닝 때문에
#  /var/log/caddy 쓰기가 거부되어 기동 자체가 실패한다.)

@DOMAIN@ {
	encode zstd gzip

	# 접속 IP 를 본인 것만 허용하려면 아래 두 줄의 주석을 풀고 대역을 넣는다.
	# @blocked not remote_ip 1.2.3.0/24
	# respond @blocked 403

	reverse_proxy 127.0.0.1:@APP_PORT@ {
		header_up X-Real-IP {remote_host}
		# WebSocket(/ws) 업그레이드는 Caddy 가 자동 처리한다.
	}
}
