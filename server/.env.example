# elemensha server - 실제 값은 서버의 .env 에만 둔다 (git 커밋 금지)
ELEMENSHA_DATA_DIR=/opt/elemensha/data
ELEMENSHA_HOST=0.0.0.0
ELEMENSHA_PORT=8080
# 앱 최초 연결용 코드. 비워두면 부팅 로그에 자동 생성분이 1회 출력된다.
ELEMENSHA_PAIRING_CODE=
# APK 인앱 업데이트용 GitHub 저장소 (예: elemensha/elemensha-app)
ELEMENSHA_GITHUB_REPO=
ELEMENSHA_LOG_LEVEL=info
