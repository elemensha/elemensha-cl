# 셸 스크립트·설정 파일은 반드시 LF. Windows 에서 편집해도 CRLF 로 커밋되지 않게 한다.
# (CRLF 로 서버에 올라가면 bash 가 'set -euo pipefail\r' 을 잘못 읽어 실패한다)
*.sh          text eol=lf
*.py          text eol=lf
*.template    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.kt          text eol=lf
*.kts         text eol=lf
*.xml         text eol=lf
*.pro         text eol=lf
Caddyfile     text eol=lf
requirements.txt text eol=lf
.env.example  text eol=lf
*.gradle      text eol=lf

*.png  binary
*.jpg  binary
*.jks  binary
*.apk  binary
